    {
      "parameters": {
        "chatId": "TWOJE_TELEGRAM_CHAT_ID",
        "text": "=🧾 Rachunki na {{ $json.data[0].okres }}: {{ $json.data.length }} szt., razem {{ $json.data.reduce((s, r) => s + r.kwota, 0) }} zł\n\n{{ $json.data.map(r => (r.zaplacone ? '✅ ' : '• ') + r.nazwa + ' - ' + r.kwota + ' zł, do ' + DateTime.fromJSDate(new Date(r.termin)).setZone('Europe/Warsaw').toFormat('dd.MM') + (r.kto !== 'paweł' ? ' (' + r.kto + ')' : '')).join('\\n') }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        416,
        -256
      ],
      "id": "d05f8999-2183-4459-b942-f101e69e9f4d",
      "name": "Send a text message"
    },
    {
      "parameters": {
        "jsCode": "// Why Code: arytmetyka na datach (co ile miesięcy, krótszy luty, koniec rat) - w Filter/Set byłoby nieczytelne\nconst TEST_MIESIAC = '';         // test: np. '2027-01' = wygeneruj tylko ten miesiąc. Na produkcji: ''\nconst OD_MIESIACA = '2026-12';   // wcześniejszych nie generujemy (listopad zapłacony poza systemem)\nconst STREFA = 'Europe/Warsaw';\nconst data = v => v instanceof Date ? DateTime.fromJSDate(v, { zone: STREFA }) : DateTime.fromISO(String(v), { zone: STREFA });\n\n// Które miesiące: zawsze bieżący (gdyby komp był wyłączony od 25. do początku miesiąca),\n// a od 25. dnia także następny. Duplikaty odsiewa \"Jeszcze nie ma?\", więc odpalanie co godzinę nic nie psuje.\nconst teraz = DateTime.now().setZone(STREFA);\nconst cele = (TEST_MIESIAC\n  ? [DateTime.fromISO(TEST_MIESIAC + '-01', { zone: STREFA })]\n  : [teraz.startOf('month'), ...(teraz.day >= 25 ? [teraz.plus({ months: 1 }).startOf('month')] : [])]\n).filter(cel => cel.toFormat('yyyy-MM') >= OD_MIESIACA);\n\nconst wyniki = [];\nfor (const cel of cele) {\n  const okres = cel.toFormat('yyyy-MM');\n  for (const item of $input.all()) {\n    const o = item.json;\n    if (!o.od_kiedy) continue;                                   // bez daty startu nie wiemy, kiedy wypada\n    const start = data(o.od_kiedy);\n    const ileMies = (cel.year - start.year) * 12 + (cel.month - start.month);\n    if (ileMies < 0 || ileMies % (o.co_ile_mies || 1) !== 0) continue;   // jeszcze nie obowiązuje / nie ten miesiąc\n    if (o.koniec && data(o.koniec).startOf('month') < cel) continue;     // raty już spłacone\n    const dzien = Math.min(o.dzien_platnosci || 1, cel.daysInMonth);    // 31. w lutym -> 28/29\n    const termin = cel.set({ day: dzien, hour: 12 });\n    const automat = o.zrodlo === 'automat';\n    wyniki.push({ json: {\n      oplata_id: o.id, nazwa: o.nazwa, kategoria: o.kategoria, kwota: o.kwota ?? 0,\n      okres, termin: termin.toISO(), kto: o.kto, zrodlo: o.zrodlo,\n      zaplacone: automat, data_zaplaty: automat ? termin.toISO() : null,\n    } });\n  }\n}\nreturn wyniki;"
      },
