        "jsCode": "const pamiec = $getWorkflowStaticData('global');\npamiec.ostatni ??= {};\npamiec.pominiete ??= {};\nconst teraz = Date.now();\nconst OKNO = 30 * 60 * 1000;\nconst wyjscie = [];\nfor (const it of $input.all()) {\n  const id = it.json.workflow?.id ?? 'nieznany';\n  if (teraz - (pamiec.ostatni[id] ?? 0) < OKNO) {\n    pamiec.pominiete[id] = (pamiec.pominiete[id] ?? 0) + 1;\n    continue;\n  }\n  it.json.pominiete = pamiec.pominiete[id] ?? 0;\n  pamiec.pominiete[id] = 0;\n  pamiec.ostatni[id] = teraz;\n  wyjscie.push(it);\n}\nfor (const id in pamiec.ostatni) if (teraz - pamiec.ostatni[id] > 86400000) delete pamiec.ostatni[id];\nreturn wyjscie;"
